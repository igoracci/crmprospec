)"></div></th>`).join('')}<th class="p-2.5 text-center w-20"><button onclick="openAddColumnModalForGroup(${group.id})" class="p-0.5 rounded bg-slate-100 text-slate-500"><i data-lucide="plus" class="w-3 h-3"></i></button></th></tr></thead><tbody class="divide-y divide-slate-100/80">${group.tasks.map(t => `<tr class="hover:bg-slate-50/60 transition-colors">${group.columns.map(col => { const val = t[col.id]; if (col.type === 'text') return `<td class="p-1.5 px-2"><input type="text" value="${val||''}" onchange="updateCellValue(${group.id}, ${t.id}, '${col.id}', this.value)" class="cell-input font-medium text-slate-700 text-xs"></td>`; if (col.type === 'whatsapp') { const num = String(val||'').replace(/\D/g, ''); const fnum = num.length>=10 && !num.startsWith('55') ? '55'+num : num; return `<td class="p-1.5 px-2"><div class="flex items-center gap-1.5 bg-emerald-50/60 border border-emerald-200/80 rounded-xl p-1">${fnum ? `<a href="https://wa.me/${fnum}" target="_blank" class="bg-emerald-500 text-white p-1.5 rounded-lg"><svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg></a>` : ''}<input type="text" value="${val||''}" onchange="updateCellValue(${group.id}, ${t.id}, '${col.id}', this.value)" class="cell-input font-bold text-emerald-800 text-xs flex-1" placeholder="(21) 99999-8888"></div></td>`; } if (col.type === 'currency') return `<td class="p-1.5 px-2"><div class="flex items-center gap-1 bg-emerald-50/40 border border-emerald-200/60 rounded-md px-2 py-0.5"><span class="text-emerald-700 font-bold text-[11px]">R$</span><input type="number" step="0.01" value="${val!==undefined?val:0}" onchange="updateCellValue(${group.id}, ${t.id}, '${col.id}', parseFloat(this.value)||0)" class="w-full bg-transparent font-semibold text-emerald-700 text-xs"></div></td>`; if (col.type === 'tags') { const opts = normalizeOptions(col.options), cur = val || opts[0]?.name || '---', found = opts.find(o=>o.name===cur)||opts[0]||{name:cur, color:'#3b82f6'}; return `<td class="p-2 text-center"><button onclick="openStatusPopover(event, ${group.id}, ${t.id}, '${col.id}')" style="background-color: ${found.color};" class="status-badge px-2.5 py-1 font-semibold text-white rounded-md text-[10px] inline-flex items-center gap-1"><span>${found.name}</span><i data-lucide="chevron-down" class="w-3 h-3"></i></button></td>`; } if (col.type === 'date') return `<td class="p-1.5 px-2"><input type="date" value="${val||''}" onchange="updateCellValue(${group.id}, ${t.id}, '${col.id}', this.value)" class="cell-input text-slate-600 text-xs"></td>`; return `<td class="p-2">${val||'---'}</td>`; }).join('')}<td class="p-2 text-center"><div class="flex items-center justify-center gap-1"><div class="relative group/move" title="Mover para outro projeto/pasta"><select onchange="moveTaskToGroup(${group.id},${t.id}, this.value)" class="opacity-0 absolute inset-0 w-full h-full cursor-pointer z-10"><option value="" disabled selected>Mover...</option>${allDestOptions}</select><button class="p-1 text-slate-400 hover:text-amber-600"><i data-lucide="folder-output" class="w-3.5 h-3.5"></i></button></div><button onclick="deleteTask(${group.id},${t.id})" title="Excluir atividade (x)" class="text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-md p-1 transition-all"><i data-lucide="x" class="w-4 h-4"></i></button></div></td></tr>`).join('')}</tbody></table></div></div>`; }); }

    document.querySelector('main')?.addEventListener('scroll', closeStatusPopover);
    window.addEventListener('DOMContentLoaded', () => render());
  </script>
